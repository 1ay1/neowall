#ifndef NEOWALL_VERSION_H
#define NEOWALL_VERSION_H

/* Generated by meson from include/version.h.in. */

#define NEOWALL_VERSION_STRING "@VERSION@"

/* Numeric parts, e.g. for a shader's `#pragma neowall requires 0.6`. */
#define NEOWALL_VERSION_MAJOR @VERSION_MAJOR@
#define NEOWALL_VERSION_MINOR @VERSION_MINOR@
#define NEOWALL_VERSION_PATCH @VERSION_PATCH@

/* 0.6.1 -> 601 */
#define NEOWALL_VERSION_NUMBER \
    (NEOWALL_VERSION_MAJOR * 10000 + NEOWALL_VERSION_MINOR * 100 + NEOWALL_VERSION_PATCH)

/* Where `meson install` put shaders and sample configs ($datadir/neowall). */
#define NEOWALL_DATADIR "@DATADIR@"

/* $sysconfdir, for the system-wide config.vibe. */
#define NEOWALL_SYSCONFDIR "@SYSCONFDIR@"

#endif /* NEOWALL_VERSION_H */
