<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: CC0-1.0 -->
<component type="desktop-application">
  <id>io.github._1ay1.neowall</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>NeoWall</name>
  <summary>Live shader, image and terminal wallpapers</summary>
  <developer id="io.github._1ay1">
    <name>Ayush Bhat</name>
  </developer>
  <description>
    <p>
      NeoWall draws a wallpaper on every monitor: a still image, a
      slideshow, a live GLSL shader, or a terminal running any program.
      Shadertoy code works unchanged.
    </p>
    <p>
      Shaders can react to music, the real time of day, system load and
      where your windows are, and the garden wallpaper grows over days.
      Each monitor can show something different, or one scene can span
      several.
    </p>
    <p>
      It runs on Wayland compositors with layer shell (Hyprland, Sway,
      river, Wayfire, niri and others), KDE Plasma, and X11.
    </p>
  </description>
  <launchable type="desktop-id">io.github._1ay1.neowall.desktop</launchable>
  <icon type="stock">io.github._1ay1.neowall</icon>
  <url type="homepage">https://github.com/1ay1/neowall</url>
  <url type="bugtracker">https://github.com/1ay1/neowall/issues</url>
  <url type="vcs-browser">https://github.com/1ay1/neowall</url>
  <categories>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>wallpaper</keyword>
    <keyword>background</keyword>
    <keyword>shader</keyword>
    <keyword>shadertoy</keyword>
    <keyword>wayland</keyword>
    <keyword>live wallpaper</keyword>
  </keywords>
  <provides>
    <binary>neowall</binary>
  </provides>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="2026-11-18">
      <description>
        <p>Bug-fix and documentation release.</p>
        <ul>
          <li>shader_fps now caps the frame rate with vsync on</li>
          <li>allow_exec and --allow-exec enable exec() shader uniforms (off by default)</li>
          <li>current and list detect a daemon that is no longer running</li>
          <li>Rewritten, consolidated documentation</li>
        </ul>
      </description>
    </release>
    <release version="0.10.2" date="2026-11-18">
      <description>
        <p>Bug-fix release.</p>
        <ul>
          <li>Fixes undefined behaviour in the window backends found with sanitizers</li>
          <li>Fixes several neowall render issues, and adds render --video</li>
          <li>Fixes the neon_city camera clipping into a tower</li>
          <li>Multi-monitor Hyprland coverage is cached per monitor</li>
        </ul>
      </description>
    </release>
    <release version="0.10.1" date="2026-11-18">
      <description>
        <p>New default wallpaper.</p>
        <ul>
          <li>tokyo_night, a rainy neon Tokyo skyline that follows the clock and the mouse, is the default wallpaper</li>
          <li>Builds on musl again</li>
        </ul>
      </description>
    </release>
    <release version="0.10.0" date="2026-11-18">
      <description>
        <p>Shader authoring and performance release.</p>
        <ul>
          <li>New neowall render: draw a shader to a PNG offscreen, with contact sheets, time of day and pinned inputs</li>
          <li>render --bench reports real GPU time per pass; render --check finds NaN and Inf pixels per pass</li>
          <li>The palette setting lets shaders follow the desktop colour theme</li>
          <li>Shaders can be named without an extension</li>
          <li>Preview no longer replaces the daemon's reported wallpaper</li>
          <li>Release tarballs ship the example shaders, and a bare binary starts with a working shader</li>
          <li>Near-zero CPU while the wallpaper is covered; idle audio analysis is skipped</li>
        </ul>
      </description>
    </release>
    <release version="0.9.0" date="2026-11-14">
      <description>
        <p>Packaging and robustness release.</p>
        <ul>
          <li>Recovers from GPU resets and lost surfaces by restarting cleanly</li>
          <li>Runs as a systemd notify service and reports readiness</li>
          <li>Ships only freely licensed shaders; the default is now garden</li>
          <li>Reloads and shader changes never freeze the wallpaper while compiling</li>
          <li>A static wallpaper uses no CPU when idle</li>
          <li>Fixes black wallpapers on NVIDIA</li>
          <li>X11 survives stray protocol errors instead of exiting</li>
          <li>Fixes several memory bugs in the terminal, image and font readers found by fuzzing</li>
          <li>Refuses GNOME on Wayland clearly instead of showing nothing</li>
        </ul>
      </description>
    </release>
    <release version="0.8.0" date="2026-10-26"/>
    <release version="0.7.2" date="2026-09-22"/>
    <release version="0.7.1" date="2026-09-16"/>
    <release version="0.7.0" date="2026-09-09"/>
  </releases>
</component>
