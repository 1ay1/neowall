# neowall configuration reference.
#
# Every option, commented out. This file is a reference only: neowall reads
# ~/.config/neowall/config.vibe. Copy what you need there and run
# `neowall reload`. Full documentation: CONFIGURATION.md, `man neowall.vibe`.
#
# Syntax: blocks of `key value` lines, `#` comments. Quote values with spaces.

# ---- Top-level keys -------------------------------------------------------

# mouse_interaction true     # let shaders see the pointer (iMouse)
# term_raw_input false       # pass Ctrl-C etc. to a focused terminal wallpaper
# allow_exec false           # let shader manifests run commands (exec("..."))
# shader_pause_ease_ms 0     # ease pause-shader/resume-shader over this many ms

# ---- default: applies to every monitor without its own block ---------------

default {
  # Show exactly ONE of shader, path or terminal.

  # A GLSL shader. A bare name is looked up in ~/.config/neowall/shaders/
  # and the installed shaders; a directory (ending in /) cycles through them.
  shader tokyo_night
  # path ~/Pictures/Wallpapers/          # an image, or a directory of them
  # terminal btop                        # a terminal program as the wallpaper

  # -- shaders --
  # shader_speed 1.0          # animation speed
  # shader_fps 30             # cap the frame rate (unset: the monitor's refresh)
  # vsync true                # tear-free; false paces by shader_fps alone
  # palette "#1a1b26 #c0caf5 #7aa2f7 #bb9af7 #7dcfff"   # iPalette: bg, fg, accents
  # palette ~/.config/kitty/current-theme.conf          # ...or any theme file
  # channels [ rgba_noise ~/Pictures/texture.png ]       # fill iChannel0..3
  # pause_on_fullscreen true  # stop while a fullscreen window covers it
  # pause_coverage_threshold 0.8   # Hyprland: stop when tiled windows cover 80%
  # show_fps false            # frame rate in a corner

  # -- images and cycling (also cycles a directory of shaders) --
  # mode fill                 # fill | fit | center | stretch | tile
  # duration 300              # seconds between wallpapers; 0 = don't cycle
  # shuffle false             # random order
  # transition fade           # fade | slide_left | slide_right | glitch | pixelate | none
  # transition_duration 0.3   # seconds

  # -- several monitors as one --
  # span true                 # stretch across all spanning monitors
  # span_group desk           # or only across monitors sharing this name

  # -- terminal wallpapers --
  # term_font_size 16         # cell size in pixels
  # term_font /usr/share/fonts/TTF/JetBrainsMono-Regular.ttf
  # term_font_bold /path/Bold.ttf
  # term_font_italic /path/Italic.ttf
  # term_cols 0               # grid size; 0 fits the screen
  # term_rows 0
  # term_fg "#c0caf5"         # default colours (quote: # starts a comment)
  # term_bg "#1a1b26"
  # term_cwd ~                # working directory
  # term_env xterm-256color   # $TERM for the program
  # term_shader crt.glsl      # post-process the terminal image
  # term_bloom 0.3            # built-in effects, 0..1:
  # term_scanline 0.2         #   term_fade term_bloom term_scanline
  # term_crt 0.0              #   term_crt term_chroma
  # term_chroma 0.0
}

# ---- output: per-monitor blocks, by connector (see `neowall current`) ------

# output {
#   DP-1 {
#     shader moon_ocean
#   }
#   HDMI-A-1 {
#     path ~/Pictures/Wallpapers/
#     duration 600
#     transition glitch
#   }
#   eDP-1 {
#     terminal btop
#   }
# }
